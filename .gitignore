# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore sensitive variables and keys (CRITICAL SECURITY RISK)

*.tfvars 
*.tfvars.json
*.hcl
*.pem
private/
tfplan.txt

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore lock info and CLI configuration
.terraform.tfstate.lock.info
.terraformrc
terraform.rc
.terraform.lock.hcl
